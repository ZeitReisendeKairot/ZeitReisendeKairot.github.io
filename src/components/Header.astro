---
import { SITE_TITLE } from '../consts';
---
<header class="site-header">
  <div class="inner">
    <a class="logo" href="/">{SITE_TITLE}</a>
    <nav>
      <a href="/">首页</a>
      <a href="/blog/">全部文章</a>
      <a href="/about/">关于</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: rgba(253, 253, 252, 0.85);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 0.8rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .logo {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--fg);
  }
  .logo:hover { color: var(--accent); text-decoration: none; }
  nav { display: flex; gap: 1.1rem; }
  nav a { color: var(--muted); font-size: 0.95rem; }
  nav a:hover { color: var(--accent); text-decoration: none; }
  @media (max-width: 480px) {
    .inner { flex-direction: column; gap: 0.4rem; }
  }
</style>
