---
// 文章详情页布局：标题、日期、标签 + 正文排版
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  series?: string;
  draft?: boolean;
}

const { title, description, pubDate, updatedDate, tags = [], series, draft = false } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="prose">
    <header class="post-header">
      {draft && <span class="badge">草稿 · 仅本地预览可见</span>}
      <h1>{title}</h1>
      <div class="meta">
        {series && <span class="tag series-tag">系列 · {series}</span>}
        <span>发布于 <FormattedDate date={pubDate} /></span>
        {updatedDate && (
          <span>更新于 <FormattedDate date={updatedDate} /></span>
        )}
        {tags.map((tag) => <span class="tag">#{tag}</span>)}
      </div>
    </header>
    <slot />
  </article>
</BaseLayout>
