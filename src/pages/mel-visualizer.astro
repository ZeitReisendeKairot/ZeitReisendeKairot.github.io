// 语音频谱实验室：真伪语音对比 + 交互式频谱工具
// ──────────────────────────────────────────────────────────────────
// 前身是《用眼睛"听"出伪造语音》文章 + 独立小工具，现合并为一页。
// 交互工具的核心（FFT、窗函数、梅尔滤波器组）全部手写，不依赖任何库。
// ══════════════════════════════════════════════════════════════════
import BaseLayout from '../layouts/BaseLayout.astro';

// 代码示例：放在 frontmatter 里再 set:html 注入，避免模板把 { } 当表达式解析
const CODE_SAMPLE = `// ① 窗函数：不同窗在"主瓣宽度"和"旁瓣泄漏"之间取舍
function makeWindow(type, N) {
  return Array.from({ length: N }, (_, n) => {
    const x = (2 * Math.PI * n) / N;
    if (type === 'hann')     return 0.5 - 0.5 * Math.cos(x);
    if (type === 'hamming')  return 0.54 - 0.46 * Math.cos(x);
    if (type === 'blackman') return 0.42 - 0.5 * Math.cos(x) + 0.08 * Math.cos(2 * x);
    return 1; // boxcar 矩形窗
  });
}

// ② radix-2 FFT：位反转重排 + 蝶形运算，O(N log N)

// ③ 梅尔滤波器组：HTK 刻度 m = 2595·log10(1 + f/700)
//    在梅尔轴上等距放 n_mels+2 个三角形滤波器的中心，再映射回 Hz 加权求和`;
---

<BaseLayout title="语音频谱实验室" description="真伪语音对比实验 + 交互式频谱工具（手写 FFT / 窗函数 / 梅尔滤波器组）">
