<script>
  // ─────────────────── 手写 DSP 核心（无任何外部依赖）───────────────────

  // 窗函数：矩形/汉宁/汉明/布莱克曼
  function makeWindow(type, N) {
    return Array.from({ length: N }, (_, n) => {
      const x = (2 * Math.PI * n) / N;
      if (type === 'hann') return 0.5 - 0.5 * Math.cos(x);
      if (type === 'hamming') return 0.54 - 0.46 * Math.cos(x);
      if (type === 'blackman') return 0.42 - 0.5 * Math.cos(x) + 0.08 * Math.cos(2 * x);
      return 1; // boxcar
    });
  }

  // 迭代式 radix-2 FFT（原位计算，O(N log N)）
  function fft(re, im) {
    const n = re.length;
    for (let i = 1, j = 0; i < n; i++) {
      let bit = n >> 1;
      for (; j & bit; bit >>= 1) j ^= bit;
      j ^= bit;
      if (i < j) { [re[i], re[j]] = [re[j], re[i]]; [im[i], im[j]] = [im[j], im[i]]; }
    }
    for (let len = 2; len <= n; len <<= 1) {
      const ang = (-2 * Math.PI) / len;
      const wRe = Math.cos(ang), wIm = Math.sin(ang);
      for (let i = 0; i < n; i += len) {
        let curRe = 1, curIm = 0;
        for (let k = 0; k < len / 2; k++) {
          const uRe = re[i + k], uIm = im[i + k];
          const vRe = re[i + k + len / 2] * curRe - im[i + k + len / 2] * curIm;
          const vIm = re[i + k + len / 2] * curIm + im[i + k + len / 2] * curRe;
          re[i + k] = uRe + vRe; im[i + k] = uIm + vIm;
          re[i + k + len / 2] = uRe - vRe; im[i + k + len / 2] = uIm - vIm;
          const nRe = curRe * wRe - curIm * wIm;
          curIm = curRe * wIm + curIm * wRe; curRe = nRe;
        }
      }
    }
  }

  // HTK 梅尔刻度 + 三角滤波器组
  const hz2mel = (f) => 2595 * Math.log10(1 + f / 700);
  const mel2hz = (m) => 700 * (10 ** (m / 2595) - 1);

  function melFilterbank(nMels, nFft, sr, fmax) {
    const nBins = nFft / 2 + 1;
    const melHi = hz2mel(Math.min(fmax, sr / 2));
    const centers = Array.from({ length: nMels + 2 }, (_, i) => mel2hz((melHi * i) / (nMels + 1)));
    const hzPerBin = sr / nFft;
    const fb = Array.from({ length: nMels }, () => new Float64Array(nBins));
    for (let m = 0; m < nMels; m++) {
      const left = centers[m], mid = centers[m + 1], right = centers[m + 2];
      for (let b = 0; b < nBins; b++) {
        const f = b * hzPerBin;
        if (f >= left && f <= mid && mid > left) fb[m][b] = (f - left) / (mid - left);
        else if (f > mid && f <= right && right > mid) fb[m][b] = (right - f) / (right - mid);
      }
    }
    return fb;
  }

  // magma 配色（10 色标线性插值）
  const MAGMA = ['#000004', '#1d1147', '#3b0f70', '#51127c', '#822681', '#b63679', '#e65164', '#fb8861', '#fec287', '#fcfdbf'];
  function magma(t) {
    const stops = MAGMA.length - 1;
    const x = Math.max(0, Math.min(1, t)) * stops;
    const i = Math.floor(x), f = x - i;
    const a = MAGMA[i] || '#000004', b = MAGMA[Math.min(i + 1, stops)];
    const pa = [1, 3, 5].map((k) => parseInt(a.slice(k, k + 2), 16));
    const pb = [1, 3, 5].map((k) => parseInt(b.slice(k, k + 2), 16));
    return `rgb(${pa.map((v, k) => Math.round(v + f * (pb[k] - v))).join(',')})`;
  }

  // ─────────────────── 交互逻辑 ───────────────────
  const $ = (id) => document.getElementById(id);
  const cache = new Map();   // 音频 url -> {data, sr}
  let audioA = null, audioB = null, timer = null;

  async function loadAudio(url) {
    if (cache.has(url)) return cache.get(url);
    const res = await fetch(url);
    const buf = await res.arrayBuffer();
    const ctx = new AudioContext({ sampleRate: 22050 });
    const decoded = await ctx.decodeAudioData(buf);
    const out = { data: decoded.getChannelData(0), sr: decoded.sampleRate };
    cache.set(url, out);
    return out;
  }

  const AUDIO_NAMES = {
    '/audio/rvf-real.wav': '真实语音',
    '/audio/rvf-melgan.wav': 'MelGAN 伪造',
    '/audio/rvf-hifigan.wav': 'HiFi-GAN 伪造',
  };

  function params() {
    const nFft = parseInt($('nfftSel').value, 10);
    const winLen = Math.min(parseInt($('winlenRange').value, 10), nFft); // 帧长 ≤ n_fft
    return {
      nFft,
      winLen,
      hop: parseInt($('hopRange').value, 10),
      nMels: parseInt($('nmelRange').value, 10),
      fmax: parseInt($('fmaxRange').value, 10),
      topDb: parseInt($('dbRange').value, 10),
      mode: $('modeSel').value,
      winType: $('winSel').value,
    };
  }

  // 计算谱图矩阵（手写流程：分帧 → 加窗 → FFT → 滤波器组 → dB）
  function spectrogram(audio, p) {
    const { data, sr } = audio;
    const nBins = p.nFft / 2 + 1;
    const win = makeWindow(p.winType, p.winLen);
    const frames = Math.max(1, Math.floor((data.length - p.winLen) / p.hop) + 1);
    const re = new Float64Array(p.nFft), im = new Float64Array(p.nFft);
    const power = new Float64Array(frames * nBins);

    for (let f = 0; f < frames; f++) {
      const off = f * p.hop;
      re.fill(0); im.fill(0);
      for (let i = 0; i < p.winLen; i++) re[i] = data[off + i] * win[i];
      fft(re, im);
      for (let b = 0; b < nBins; b++) power[f * nBins + b] = re[b] * re[b] + im[b] * im[b];
    }

    let rows, rowHz;
    if (p.mode === 'mel') {
      const fb = melFilterbank(p.nMels, p.nFft, sr, p.fmax);
      rows = Array.from({ length: p.nMels }, (_, m) => {
        const row = new Float64Array(frames);
        for (let f = 0; f < frames; f++) {
          let s = 0;
          for (let b = 0; b < nBins; b++) s += fb[m][b] * power[f * nBins + b];
          row[f] = s;
        }
        return row;
      });
      const melHi = hz2mel(Math.min(p.fmax, sr / 2));
      rowHz = Array.from({ length: p.nMels }, (_, m) => mel2hz((melHi * (m + 1)) / (p.nMels + 1)));
    } else {
      rows = Array.from({ length: nBins }, (_, b) => {
        const row = new Float64Array(frames);
        for (let f = 0; f < frames; f++) row[f] = power[f * nBins + b];
        return row;
      });
      rowHz = Array.from({ length: nBins }, (_, b) => (b * sr) / p.nFft);
    }

    let maxV = 0;
    for (const r of rows) for (const v of r) if (v > maxV) maxV = v;
    const lo = Math.log10(Math.max(maxV, 1e-12)) - p.topDb / 10;
    const db = rows.map((r) => Array.from(r, (v) => Math.log10(Math.max(v, 1e-12))));
    return { db, rowHz, lo, frames, range: p.topDb / 10 };
  }

  function draw(canvas, spec, p, sr) {
    const ctx = canvas.getContext('2d');
    const W = canvas.width, H = canvas.height, L = 64, B = 30, T = 8, R = 8;
    const plotW = W - L - R, plotH = H - T - B;
    ctx.fillStyle = '#000004';
    ctx.fillRect(0, 0, W, H);
    const nR = spec.db.length;
    for (let m = 0; m < nR; m++) {
      for (let f = 0; f < spec.frames; f++) {
        const t01 = (spec.db[m][f] - spec.lo) / spec.range;
        ctx.fillStyle = magma(t01);
        const x = L + (f / spec.frames) * plotW;
        const y = T + (1 - (m + 1) / nR) * plotH;
        ctx.fillRect(x, y, plotW / spec.frames + 0.8, plotH / nR + 0.8);
      }
    }
    // 坐标轴
    ctx.fillStyle = '#94a3b8';
    ctx.font = '12px system-ui, sans-serif';
    const dur = (spec.frames * p.hop) / sr;
    for (let s = 0; s <= dur; s += 0.5) {
      const x = L + (s / dur) * plotW;
      ctx.fillText(s.toFixed(1) + 's', x - 8, H - 10);
      ctx.fillRect(x, T + plotH, 1, 4);
    }
    const fMaxActual = p.mode === 'mel' ? Math.min(p.fmax, sr / 2) : sr / 2;
    const nTicks = 6;
    for (let k = 0; k <= nTicks; k++) {
      let hz;
      if (p.mode === 'mel') hz = mel2hz((hz2mel(fMaxActual) * k) / nTicks);
      else hz = (fMaxActual * k) / nTicks;
      let row = spec.rowHz.findIndex((h) => h >= hz);
      if (row < 0) row = spec.rowHz.length - 1;
      const y = T + (1 - row / spec.rowHz.length) * plotH;
      ctx.fillText(hz >= 1000 ? (hz / 1000).toFixed(1) + 'k' : Math.round(hz), 6, y + 4);
      ctx.fillRect(L - 5, y, 4, 1);
    }
  }

  function render() {
    if (!audioA) return;
    const t0 = performance.now();
    const p = params();
    const sr = audioA.sr;
    const specA = spectrogram(audioA, p);
    draw($('spec'), specA, p, sr);
    const abOn = $('abCheck').checked;
    document.querySelector('.lab').classList.toggle('ab', abOn);
    if (abOn && audioB) {
      draw($('specB'), spectrogram(audioB, p), p, sr);
    }
    $('labelA').textContent = 'A：' + AUDIO_NAMES[$('audioSel').value];
    $('labelB').textContent = 'B：' + AUDIO_NAMES[$('audioBSel').value];
    const ms = performance.now() - t0;
    $('readout').textContent =
      `帧长 ${p.winLen} · 窗 ${p.winType} · n_fft ${p.nFft}${p.winLen < p.nFft ? '（补零）' : ''} · hop ${p.hop} · ` +
      `Δf = ${(sr / p.nFft).toFixed(1)} Hz · Δt = ${((p.hop / sr) * 1000).toFixed(1)} ms · ` +
      `${specA.frames} 帧 × ${specA.db.length} 频带 · 计算${abOn ? '×2' : ''}+绘图 ${ms.toFixed(0)} ms`;
  }

  function schedule() {
    clearTimeout(timer);
    timer = setTimeout(render, 120);
  }

  function syncLabels() {
    $('hopVal').textContent = $('hopRange').value;
    $('nmelVal').textContent = $('nmelRange').value;
    $('fmaxVal').textContent = $('fmaxRange').value + ' Hz';
    $('dbVal').textContent = '±' + $('dbRange').value + ' dB';
    $('winlenVal').textContent = $('winlenRange').value;
    $('nfftVal').textContent = $('nfftSel').value;
    const isMel = $('modeSel').value === 'mel';
    document.querySelectorAll('.melOnly').forEach((el) => (el.style.display = isMel ? '' : 'none'));
  }

  ['modeSel', 'winSel', 'nfftSel', 'hopRange', 'winlenRange', 'nmelRange', 'fmaxRange', 'dbRange', 'abCheck'].forEach((id) =>
    $(id).addEventListener('input', () => { syncLabels(); schedule(); })
  );
  $('audioSel').addEventListener('change', async () => {
    audioA = await loadAudio($('audioSel').value);
    render();
  });
  $('audioBSel').addEventListener('change', async () => {
    audioB = await loadAudio($('audioBSel').value);
    render();
  });

  (async () => {
    syncLabels();
    [audioA, audioB] = await Promise.all([loadAudio($('audioSel').value), loadAudio($('audioBSel').value)]);
    render();
  })();
</script>
