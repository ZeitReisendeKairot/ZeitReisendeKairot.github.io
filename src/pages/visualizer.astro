// ══════════════════════════════════════════════════════════════════
// 语音频谱实验室（/visualizer/）
// ──────────────────────────────────────────────────────────────────
// 真伪语音对比实验 + 交互式频谱工具。
// 交互工具的核心（FFT、窗函数、梅尔滤波器组、预加重）全部手写，不依赖任何库。
// 旧地址 /mel-visualizer/ 已在 astro.config.mjs 里重定向到这里。
// ══════════════════════════════════════════════════════════════════
import BaseLayout from '../layouts/BaseLayout.astro';

// 代码示例通过 set:html 注入：Astro 模板会把 HTML 里的 { } 当表达式解析，
// 所以含花括号的代码必须放进 JS 字符串里再注入（这是一个经典的坑）。
const CODE_JS = `// ========== 手写版（本页工具的实际实现，JavaScript）==========

// ① 预加重：一阶高通滤波，补偿语音的高频滚降
function preEmphasis(x, a) {
  const y = new Float64Array(x.length);
  for (let t = 1; t < x.length; t++) y[t] = x[t] - a * x[t - 1];
  return y;
}

// ② 窗函数：不同窗在"主瓣宽度"和"旁瓣泄漏"之间取舍
function makeWindow(type, N) {
  return Array.from({ length: N }, (_, n) => {
    const x = (2 * Math.PI * n) / N;
    if (type === 'hann')     return 0.5 - 0.5 * Math.cos(x);
    if (type === 'hamming')  return 0.54 - 0.46 * Math.cos(x);
    if (type === 'blackman') return 0.42 - 0.5 * Math.cos(x) + 0.08 * Math.cos(2 * x);
    return 1; // boxcar 矩形窗
  });
}

// ③ radix-2 FFT：位反转重排 + 蝶形运算，O(N log N)
function fft(re, im) {
  const n = re.length;
  for (let i = 1, j = 0; i < n; i++) {          // 位反转重排
    let bit = n >> 1;
    for (; j & bit; bit >>= 1) j ^= bit;
    j ^= bit;
    if (i < j) { [re[i], re[j]] = [re[j], re[i]]; [im[i], im[j]] = [im[j], im[i]]; }
  }
  for (let len = 2; len <= n; len <<= 1) {      // 蝶形运算
    const ang = (-2 * Math.PI) / len;
    const wRe = Math.cos(ang), wIm = Math.sin(ang);
    for (let i = 0; i < n; i += len) {
      let curRe = 1, curIm = 0;
      for (let k = 0; k < len / 2; k++) {
        const uRe = re[i+k], uIm = im[i+k];
        const vRe = re[i+k+len/2]*curRe - im[i+k+len/2]*curIm;
        const vIm = re[i+k+len/2]*curIm + im[i+k+len/2]*curRe;
        re[i+k] = uRe+vRe;            im[i+k] = uIm+vIm;
        re[i+k+len/2] = uRe-vRe;      im[i+k+len/2] = uIm-vIm;
        const nRe = curRe*wRe - curIm*wIm;
        curIm = curRe*wIm + curIm*wRe; curRe = nRe;
      }
    }
  }
}

// ④ 梅尔滤波器组：HTK 刻度 m = 2595·log10(1 + f/700)
const hz2mel = (f) => 2595 * Math.log10(1 + f / 700);
const mel2hz = (m) => 700 * (10 ** (m / 2595) - 1);
function melFilterbank(nMels, nFft, sr, fmax) {
  const nBins = nFft / 2 + 1;
  const melHi = hz2mel(Math.min(fmax, sr / 2));
  // 在梅尔轴上等距取 n_mels+2 个中心，映射回 Hz，做成三角形滤波器
  const centers = Array.from({ length: nMels + 2 },
    (_, i) => mel2hz((melHi * i) / (nMels + 1)));
  const fb = Array.from({ length: nMels }, () => new Float64Array(nBins));
  for (let m = 0; m < nMels; m++) {
    const [left, mid, right] = [centers[m], centers[m+1], centers[m+2]];
    for (let b = 0; b < nBins; b++) {
      const f = (b * sr) / nFft;
      if (f >= left && f <= mid && mid > left)      fb[m][b] = (f - left) / (mid - left);
      else if (f > mid && f <= right && right > mid) fb[m][b] = (right - f) / (right - mid);
    }
  }
  return fb;
}

// ⑤ 完整流水线：分帧 → 加窗 → FFT → 滤波器组 → 取 dB
function spectrogram(x, sr, p) {
  const win = makeWindow(p.winType, p.winLen);
  const nBins = p.nFft / 2 + 1;
  const frames = Math.floor((x.length - p.winLen) / p.hop) + 1;
  const power = new Float64Array(frames * nBins);
  const re = new Float64Array(p.nFft), im = new Float64Array(p.nFft);
  for (let f = 0; f < frames; f++) {
    re.fill(0); im.fill(0);
    for (let i = 0; i < p.winLen; i++) re[i] = x[f*p.hop + i] * win[i];
    fft(re, im);
    for (let b = 0; b < nBins; b++) power[f*nBins + b] = re[b]**2 + im[b]**2;
  }
  // 梅尔滤波（线性谱模式则跳过这步直接用 power）
  // ... 之后每个滤波器对 power 加权求和，再取 10·log10 并减去最大值 → 相对 dB
}`;

const CODE_PY = `# ========== librosa 版（Python，同样的流水线，一行一个零件）==========
import librosa
import numpy as np

y, sr = librosa.load("LJ014-0227.wav", sr=22050)

# ① 预加重（librosa 没有现成函数，手写一行）
y = np.append(y[0], y[1:] - 0.97 * y[:-1])

# ② + ③ + ⑤ 梅尔谱：分帧、汉宁窗、FFT、80 个梅尔滤波器，一步到位
mel = librosa.feature.melspectrogram(
    y=y, sr=sr, n_fft=1024,        # FFT 点数（补零后的长度）
    hop_length=256,                 # 帧移
    win_length=1024,                # 帧长（窗长），可比 n_fft 小
    window="hann",                  # 窗函数："hann" / "hamming" / "blackman" / "boxcar"
    n_mels=80, fmax=8000,           # 梅尔滤波器数、最高频率
)
mel_db = librosa.power_to_db(mel, ref=np.max)   # 功率 → 相对 dB

# 线性 STFT 谱（等价于本工具的"线性频谱"模式）
stft = np.abs(librosa.stft(y, n_fft=1024, hop_length=256, window="hann"))
stft_db = librosa.amplitude_to_db(stft, ref=np.max)

# 两个库的对应关系：
#   本页 makeWindow()      ↔  window 参数
#   本页 fft()             ↔  librosa.stft() 内部（底层是 pocketfft）
#   本页 melFilterbank()   ↔  librosa.filters.mel()（默认 Slaney 刻度，略有差异）
#   本页 preEmphasis()     ↔  手写 np.append 那一行`;
---

<BaseLayout title="语音频谱实验室" description="真伪语音对比实验 + 交互式频谱工具（手写 FFT / 窗函数 / 梅尔滤波器组 / 预加重）">
